# /etc/systemd/system/attest.service
[Unit]
Description=Node Attestation Gate
DefaultDependencies=no
After=network-online.target containerd.service
Wants=network-online.target
Before=kubelet.service
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=oneshot
EnvironmentFile=-/etc/default/attest
ExecStart=/opt/azure/containers/attest.sh
# Post step applies taints/labels based on /var/lib/attest/status.json
ExecStartPost=/usr/local/bin/attest-gating.sh
RemainAfterExit=yes
StandardOutput=journal
StandardError=journal
Restart=on-failure
RestartSec=20
RestartPreventExitStatus=10
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
